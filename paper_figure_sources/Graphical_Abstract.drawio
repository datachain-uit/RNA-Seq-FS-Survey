<mxCell id="c2" value="Gene selection under a panel budget
20,000 genes → k ≤ 10
5 lung cancer cohorts (RNA-seq source, 4 microarray targets, 2 platforms)
13 selectors, 4 families + random-k, B0, IHC, published panels
patient-level, leak-free protocol; 8 budgets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="260" height="230" as="geometry"/></mxCell>
<mxCell id="c3" value="Performance under k: 4–10 genes match the full profile; random panels catch up by k = 50 on two cohorts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="30" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="c4" value="Cost: 0.06 s to 892 s, set by the implementation, not the family" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="95" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="c5" value="Stability: Nogueira 0.99 to 0.26 at equal AUROC; no method dominates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="160" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="c6" value="Few-shot, transfer: 5 patients/class give accuracy, not a reproducible panel; pooling a source never hurts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#666666;fontSize=10;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="225" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="c7" value="Decision framework
1. signal check (E0)
2. budget k (E1)
3. target size n_T (E1b)
4. platform (E7)
5. family: stability × cost (E2–E6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#666666;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="690" y="40" width="230" height="230" as="geometry"/></mxCell>
