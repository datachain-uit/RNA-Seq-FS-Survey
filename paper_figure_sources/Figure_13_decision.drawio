<mxCell id="1" parent="0"/>
<mxCell id="c1" value="&lt;b&gt;Task: panel of &lt;i&gt;k&lt;/i&gt; genes for a diagnostic label&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11.5px;&quot; color=&quot;#334155&quot;&gt;cohorts &lt;i&gt;D&lt;/i&gt;&lt;sub&gt;S&lt;/sub&gt; (source), &lt;i&gt;D&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; (target)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="2" y="2" width="392" height="38" as="geometry"/></mxCell>
<mxCell id="c2" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c1"><mxGeometry x="22" y="6" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Signal check (E0)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11.5px;&quot; color=&quot;#334155&quot;&gt;permutation &lt;i&gt;p&lt;/i&gt; &amp;lt; 0.05 and gain over random-&lt;i&gt;k&lt;/i&gt; ≥ 0.02 at the intended &lt;i&gt;k&lt;/i&gt;?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="2" y="62" width="392" height="50" as="geometry"/></mxCell>
<mxCell id="c4" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c3"><mxGeometry x="22" y="12" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="c5" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" connectable="0" parent="c3"><mxGeometry x="-9" y="16" width="18" height="18" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;Budget (E1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11.5px;&quot; color=&quot;#334155&quot;&gt;compare at fixed &lt;i&gt;k&lt;/i&gt; against random-&lt;i&gt;k&lt;/i&gt; and B0; read &lt;i&gt;k&lt;/i&gt;&lt;sup&gt;*&lt;/sup&gt; from the pooled bound; is &lt;i&gt;k&lt;/i&gt; ≤ 10?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="2" y="134" width="392" height="50" as="geometry"/></mxCell>
<mxCell id="c7" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c6"><mxGeometry x="22" y="12" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="c8" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" connectable="0" parent="c6"><mxGeometry x="-9" y="16" width="18" height="18" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b&gt;Target labels (E1b)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11.5px;&quot; color=&quot;#334155&quot;&gt;&lt;i&gt;n&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; ≥ 20 labelled patients per class?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="2" y="206" width="392" height="50" as="geometry"/></mxCell>
<mxCell id="c10" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c9"><mxGeometry x="22" y="12" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="c11" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" connectable="0" parent="c9"><mxGeometry x="-9" y="16" width="18" height="18" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Platform (E7)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11.5px;&quot; color=&quot;#334155&quot;&gt;is the target platform different from the source?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="2" y="278" width="392" height="50" as="geometry"/></mxCell>
<mxCell id="c13" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c12"><mxGeometry x="22" y="12" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="c14" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" connectable="0" parent="c12"><mxGeometry x="-9" y="16" width="18" height="18" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;Family (E2–E6)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11.5px;&quot; color=&quot;#334155&quot;&gt;within the equivalence region of E1, choose on stability and cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="2" y="350" width="392" height="50" as="geometry"/></mxCell>
<mxCell id="c16" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c15"><mxGeometry x="22" y="12" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="c17" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1E293B;strokeColor=#FFFFFF;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" connectable="0" parent="c15"><mxGeometry x="-9" y="16" width="18" height="18" as="geometry"/></mxCell>
<mxCell id="c18" value="No selection signal: the budget, not the method, decides; report random-&lt;i&gt;k&lt;/i&gt; as the reference" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FEF2F2;strokeColor=#E8A0A0;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=36;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="62" width="386" height="50" as="geometry"/></mxCell>
<mxCell id="c19" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c18"><mxGeometry x="9" y="15" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;i&gt;k&lt;/i&gt; ≥ 25: selected panels rarely beat random panels on GSE37745 and GSE10245 (0/13 methods at &lt;i&gt;k&lt;/i&gt; = 50)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FEF2F2;strokeColor=#E8A0A0;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=36;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="134" width="386" height="50" as="geometry"/></mxCell>
<mxCell id="c21" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c20"><mxGeometry x="9" y="15" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;i&gt;n&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; ≤ 10: use &lt;i&gt;k&lt;/i&gt;-TSP or a fixed knowledge panel; a data-driven panel is one of many (Nogueira ≤ 0.05 at &lt;i&gt;n&lt;/i&gt;&lt;sub&gt;T&lt;/sub&gt; = 5 for most methods)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FEF2F2;strokeColor=#E8A0A0;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=36;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="206" width="386" height="50" as="geometry"/></mxCell>
<mxCell id="c23" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c22"><mxGeometry x="9" y="15" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="c24" value="pooled or select-on-source with the target labels (never negative, up to +0.12 on GPL6884); zero-shot only at &lt;i&gt;k&lt;/i&gt; ≥ 4 with a direction check" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#F0FDF4;strokeColor=#8FCFA3;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=36;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="278" width="386" height="50" as="geometry"/></mxCell>
<mxCell id="c25" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c24"><mxGeometry x="9" y="15" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;Reproducible panel, frequent re‑selection:&lt;/b&gt;&lt;br&gt;univariate ranking (F-test): Nogueira ≈ 0.89, &amp;lt; 0.1 s; ReliefF equally stable, ≈ 140 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#F0FDF4;strokeColor=#8FCFA3;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=36;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="2" y="426" width="268" height="80" as="geometry"/></mxCell>
<mxCell id="c27" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c26"><mxGeometry x="9" y="30" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;Non‑redundant panel at &lt;i&gt;k&lt;/i&gt; ≤ 5:&lt;/b&gt;&lt;br&gt;sparse model (L1-LR, abess): Nogueira 0.3–0.7, 0.4–11 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#F0FDF4;strokeColor=#8FCFA3;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=36;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="280" y="426" width="268" height="80" as="geometry"/></mxCell>
<mxCell id="c29" value="" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;strokeColor=none;fillColor=none;" vertex="1" connectable="0" parent="c28"><mxGeometry x="9" y="30" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;b&gt;Wrappers:&lt;/b&gt;&lt;br&gt;only if the panel is not interpreted (arbitrary genes, Nogueira ≈ 0)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;absoluteArcSize=1;fillColor=#FEF2F2;strokeColor=#E8A0A0;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11.5;fontColor=#1E293B;align=left;verticalAlign=middle;spacingLeft=36;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="558" y="426" width="268" height="80" as="geometry"/></mxCell>
